# ==========================================
# SentimentScope Environment Configuration
# Copy this file to `.env` before running
# ==========================================

# Port for FastAPI application service
PORT=8000

# Disable Python buffer stdout/stderr for real-time Docker logging
PYTHONUNBUFFERED=1

# Directory path containing trained ML model artifacts (.joblib / .keras / metadata)
MODELS_DIR=models

# Directory path containing evaluation reports and metric JSON files
REPORTS_DIR=reports

# Configurable CORS allowed origins (comma-separated list, or '*' for unrestricted)
# Examples:
#   Development: http://localhost:8000,http://127.0.0.1:8000
#   Production: https://your-app-name.onrender.com,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==========================================
# Live Ingestion & Rolling Store Settings
# ==========================================

# Enable background live ingestion scheduled loop (true/false)
ENABLE_LIVE_INGESTION=true

# Default search keyword for live public ingestion (e.g. ai, tech, crypto, product)
INGESTION_KEYWORD=ai

# Background ingestion interval in minutes
INGESTION_INTERVAL_MINUTES=15

# Maximum retention row count for rolling SQLite store (oldest records pruned beyond this limit)
INGESTION_MAX_ROWS=5000

# Per-keyword manual trigger cooldown period in seconds
INGESTION_COOLDOWN_SECONDS=30

# File path for rolling SQLite database
INGESTION_DB_PATH=data/rolling_store.db
