{
  "outputDirectory": "frontend",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "models/**"
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/health", "dest": "api/index.py" },
    { "src": "/api/predict/(.*)", "dest": "api/index.py" },
    { "src": "/api/predict", "dest": "api/index.py" },
    { "src": "/api/live/(.*)", "dest": "api/index.py" },
    { "src": "/api/model/(.*)", "dest": "api/index.py" },
    { "src": "/health", "dest": "api/index.py" },
    { "src": "/predict/(.*)", "dest": "api/index.py" },
    { "src": "/predict", "dest": "api/index.py" },
    { "src": "/live/(.*)", "dest": "api/index.py" },
    { "src": "/model/(.*)", "dest": "api/index.py" },
    { "src": "/docs", "dest": "api/index.py" },
    { "src": "/openapi.json", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
